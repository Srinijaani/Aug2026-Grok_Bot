# Copy to .env and fill in to talk to the real Grok API.
# Without XAI_API_KEY the app runs in offline "demo mode".

# Your xAI API key (https://console.x.ai)
XAI_API_KEY=

# Optional overrides
# GROK_MODEL=grok-4
# XAI_API_BASE=https://api.x.ai/v1
# GROK_SYSTEM_PROMPT=You are Grok, a helpful and truthful AI built by xAI.
# PORT=3000
